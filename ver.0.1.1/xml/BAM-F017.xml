  <drmd:materialPropertiesList>
    <drmd:materialProperties isCertified="true">
      <drmd:name>
        <dcc:content lang="en">
          Certified fluorescence quantum yield and its associated uncertainty.
        </dcc:content>
      </drmd:name>
      <drmd:results>
        <dcc:result>
          <dcc:name>
            <dcc:content lang="en">Certified Value</dcc:content>
          </dcc:name>
          <dcc:description>
            <dcc:content lang="en">
              a) Ethanolic dye solution of BAM-F017 with an absorbance at the excitation wavelength between 0.09 and 0.11.
            </dcc:content>
          </dcc:description>
          <dcc:data>
            <dcc:list>
              <dcc:quantity refType="basic_measuredValue">
                <dcc:name>
                  <dcc:content lang="en">Fluorescence Quantum Yield (Φf)</dcc:content>
                </dcc:name>
                <si:real>
                  <si:value>0.61</si:value>
                  <si:unit>unitless</si:unit>
                  <si:measurementUncertaintyUnivariate>
                    <si:expandedMU>
                      <si:valueExpandedMU>0.03</si:valueExpandedMU>
                      <si:coverageFactor>2</si:coverageFactor>
                      <si:coverageProbability>0.95</si:coverageProbability>
                      <si:distribution>normal</si:distribution>
                    </si:expandedMU>
                  </si:measurementUncertaintyUnivariate>
                </si:real>
              </dcc:quantity>
            </dcc:list>
          </dcc:data>
        </dcc:result>
      </drmd:results>
    </drmd:materialProperties>
  </drmd:materialPropertiesList>
