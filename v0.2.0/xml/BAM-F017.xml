  <ns0:materials>
      <ns0:material>
        <ns0:name>
          <ns1:content lang="en">Fluorescence Quantum Yield Standard</ns1:content>
        </ns0:name>
        <ns0:description>
          <ns1:content lang="en">
            The fluorescence quantum yield standard BAM-F017 is supplied as a solid in a tightly closed glass bottle.
            The Standard Operation Procedure (SOP) based on the publication by C. Wuerth et al. is included.
          </ns1:content>
        </ns0:description>
      </ns0:material>
    </ns0:materials>
    <ns0:materialPropertiesList>
    <ns0:materialProperties isCertified="true">
      <ns0:name>
        <ns1:content lang="en">
          Certified fluorescence quantum yield and its associated uncertainty.
        </ns1:content>
      </ns0:name>
      <ns0:results>
        <ns1:result>
          <ns1:name>
            <ns1:content lang="en">Certified Value</ns1:content>
          </ns1:name>
          <ns1:description>
            <ns1:content lang="en">
              a) Ethanolic dye solution of BAM-F017 with an absorbance at the excitation wavelength between 0.09 and 0.11.
            </ns1:content>
          </ns1:description>
          <ns1:data>
            <ns1:list>
              <ns1:quantity refType="basic_measuredValue">
                <ns1:name>
                  <ns1:content lang="en">Fluorescence Quantum Yield (Φf)</ns1:content>
                </ns1:name>
                <ns2:real>
                  <ns2:value>0.61</ns2:value>
                  <ns2:unit>unitless</ns2:unit>
                  <ns2:measurementUncertaintyUnivariate>
                    <ns2:expandedMU>
                      <ns2:valueExpandedMU>0.03</ns2:valueExpandedMU>
                      <ns2:coverageFactor>2</ns2:coverageFactor>
                      <ns2:coverageProbability>0.95</ns2:coverageProbability>
                      <ns2:distribution>normal</ns2:distribution>
                    </ns2:expandedMU>
                  </ns2:measurementUncertaintyUnivariate>
                </ns2:real>
              </ns1:quantity>
            </ns1:list>
          </ns1:data>
        </ns1:result>
      </ns0:results>
    </ns0:materialProperties>
  </ns0:materialPropertiesList>
<ns0:statements>
      <ns0:intendedUse>
        <ns1:name>
          <ns1:content lang="en">Intended Use</ns1:content>
        </ns1:name>
        <ns1:content lang="en">
          BAM-F017 dissolved in absolute ethanol is certified for use as a fluorescence quantum yield standard for the relative determination of fluorescence quantum yields of transparent luminophore solutions.
        </ns1:content>
      </ns0:intendedUse>
      <ns0:storageInformation>
        <ns1:name>
          <ns1:content lang="en">Storage Information</ns1:content>
        </ns1:name>
        <ns1:content lang="en">
          This certificate is valid for 2 years after dispatch, if the solid CRM is stored at 2 - 8 °C in the dark.
          BAM-F017 can be shipped at room temperature.
        </ns1:content>
      </ns0:storageInformation>
      <ns0:instructionsForHandlingAndUse>
        <ns1:name>
          <ns1:content lang="en">Handling Instructions</ns1:content>
        </ns1:name>
        <ns1:content lang="en">
          Please follow the Standard Operation Procedure (SOP) provided with the material.
        </ns1:content>
      </ns0:instructionsForHandlingAndUse>
      <ns0:metrologicalTraceability>
        <ns1:name>
          <ns1:content lang="en">Metrological Traceability</ns1:content>
        </ns1:name>
        <ns1:content lang="en">
